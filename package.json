{
  "name": "m324-group-2",
  "private": true,
  "type": "module",
  "packageManager": "bun@1.3.14",
  "workspaces": [
    "services/*"
  ],
  "engines": {
    "bun": ">=1.3"
  },
  "scripts": {
    "dev": "bun run --filter \"./services/*\" dev",
    "test": "bun run --filter \"./services/*\" test",
    "test:coverage": "bun run --filter \"./services/*\" test:coverage",
    "test:integration": "bun run --filter \"./services/*\" test:integration",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "bun run --filter \"./services/*\" typecheck",
    "db:up": "docker compose up -d postgres",
    "db:down": "docker compose down",
    "db:migrate": "bun run --filter \"./services/*\" db:migrate"
  },
  "devDependencies": {
    "@eslint/js": "^9.18.0",
    "eslint": "^9.18.0",
    "eslint-config-prettier": "^10.0.1",
    "prettier": "^3.4.2",
    "typescript": "^5.7.3",
    "typescript-eslint": "^8.21.0"
  }
}
