meta {
  name: 06 List localities paged
  type: http
  seq: 6
}

get {
  url: {{locationsUrl}}/locations?limit=2&offset=1
  body: none
  auth: none
}

params:query {
  limit: 2
  offset: 1
}

assert {
  res.status: eq 200
  res.body.limit: eq 2
  res.body.offset: eq 1
}

tests {
  test("returns at most two items", function () {
    expect(res.body.items.length).to.be.at.most(2);
  });
}

docs {
  Paging with `limit` (1 to 500, default 100) and `offset` (default 0).
}
