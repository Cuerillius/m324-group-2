meta {
  name: 09 Get unknown locality (404)
  type: http
  seq: 9
}

get {
  url: {{locationsUrl}}/locations/00000000-0000-0000-0000-000000000000
  body: none
  auth: none
}

assert {
  res.status: eq 404
  res.body.error.code: eq NOT_FOUND
}

docs {
  A well-formed UUID that does not exist. A malformed id answers 404 as well.
}
